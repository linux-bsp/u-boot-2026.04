#include <env/ti/ti_common.env>

kernel_addr_r=0x90000000
loadaddr=0x82000000
autoload=no
netretry=once
bootpretryperiod=5000
fw_env_version=10
hwid=1010001000110000
fw_rollback_test=0
#ifndef CONFIG_USE_IPADDR
ipaddr=192.168.18.246
#endif
#ifndef CONFIG_USE_SERVERIP
serverip=192.168.18.245
#endif
#ifndef CONFIG_USE_GATEWAYIP
gatewayip=192.168.18.1
#endif
#ifndef CONFIG_USE_NETMASK
netmask=255.255.255.0
#endif
#if defined(CONFIG_AM62X_BOOT_TFTP_KERNEL) && defined(CONFIG_AM62X_BOOT_NFS_ROOT)
fw_boot_profile=tftp-nfs
#elif defined(CONFIG_AM62X_BOOT_TFTP_KERNEL)
fw_boot_profile=tftp-mmc
#elif defined(CONFIG_AM62X_BOOT_NFS_ROOT)
fw_boot_profile=mmc-nfs
#else
fw_boot_profile=mmc
#endif
#ifdef CONFIG_AM62X_BOOT_TFTP_KERNEL
tftp_kernel=1
#else
tftp_kernel=0
#endif
#ifdef CONFIG_AM62X_BOOT_NFS_ROOT
nfs_root=1
#else
nfs_root=0
#endif
tftp_kernel_file=Image
tftp_fdt_file=k3-am625-alientek.dtb
nfsroot=/srv/nfs/am625
nfsopts=vers=3,tcp
netdev=eth0
net_hostname=am625
upk=fwctl update tftp kernel.itb
upr=fwctl update tftp rootfs.itb
upb=fwctl update tftp bootloader.itb
upa=fwctl update tftp release.itb all
fw_mmcdev=1
fw_parts_a=1M(tiboot3_a),2M(tispl_a),2M(uboot_a),64K(meta0),64K(meta1),1920K(env_area)
fw_parts_b=1M(tiboot3_b),2M(tispl_b),2M(uboot_b),4M(reserved1)
fw_parts_os=24M(kernel_a),24M(kernel_b),128M(rootfs_a),128M(rootfs_b),-(data)
fw_set_root=
	if test "${fw_rootfs_slot}" = "a"; then
		setenv fw_rootpart 13;
	else
		setenv fw_rootpart 14;
	fi
ota_recovery=1
ota_serverport=8090
/* Keep this variable compatible with schema 2/3 U-Boot after A/B rollback. */
fw_load_kernel=
	mmc dev ${fw_mmcdev} &&
	setexpr fw_kernel_lba ${fw_kernel_offset} / 0x200 &&
	setexpr fw_kernel_blocks ${fw_kernel_size} / 0x200 &&
	mmc read ${kernel_addr_r} ${fw_kernel_lba} ${fw_kernel_blocks}
fw_load_checked_kernel=fwctl load-kernel ${kernel_addr_r}
fw_recover_kernel=
	if test "${ota_recovery}" = "1"; then
		fwctl recover-kernel && run fw_load_checked_kernel;
	else
		false;
	fi
fw_load_or_recover=
	if run fw_load_checked_kernel; then
		true;
	else
		echo "Kernel verification failed; requesting OTA recovery";
		run fw_recover_kernel;
	fi
fw_start_watchdog=
	wdt dev watchdog@e000000 &&
	wdt start 60000 &&
	echo "U-Boot watchdog started (60 seconds)"
fw_set_bootargs=
	setenv bootargs console=ttyS2,115200n8
	earlycon=ns16550a,mmio32,0x02800000
	${fw_rootargs} rootfstype=squashfs ro rootwait panic=5
	blkdevparts=mmcblk1:${fw_parts_a},${fw_parts_b},${fw_parts_os}
	fw.deployment=${fw_deployment}
	fw.rollback_test=${fw_rollback_test}
fw_apply_confirm=
	if test -n "${fw_confirm}"; then
		fwctl mark-good ${fw_confirm} &&
		setenv fw_confirm &&
		saveenv;
	else
		true;
	fi
fw_boot_mmc=
	run fw_apply_confirm &&
	run fw_start_watchdog &&
	fwctl select &&
	run fw_set_root &&
	run fw_load_or_recover &&
	fwctl verity-args ${kernel_addr_r} /dev/mmcblk1p${fw_rootpart} &&
	run fw_set_bootargs &&
	bootm ${kernel_addr_r}
fw_load_tftp=
	tftpboot ${kernel_addr_r} ${tftp_kernel_file} &&
	tftpboot ${fdt_addr_r} ${tftp_fdt_file}
fw_net_select=
	if test "${tftp_kernel}" = "1" && test "${nfs_root}" = "1"; then
		true;
	else
		fwctl select && run fw_set_root;
	fi
fw_set_net_bootargs=
	if test "${nfs_root}" = "1"; then
		setenv bootargs console=ttyS2,115200n8
		earlycon=ns16550a,mmio32,0x02800000
		root=/dev/nfs rw nfsroot=${serverip}:${nfsroot},${nfsopts}
		ip=${ipaddr}:${serverip}:${gatewayip}:${netmask}:${net_hostname}:${netdev}:off
		blkdevparts=mmcblk1:${fw_parts_a},${fw_parts_b},${fw_parts_os}
		bsp.netboot=1 panic=5;
	else
		setenv bootargs console=ttyS2,115200n8
		earlycon=ns16550a,mmio32,0x02800000
		root=/dev/mmcblk1p${fw_rootpart} rootfstype=squashfs ro rootwait
		blkdevparts=mmcblk1:${fw_parts_a},${fw_parts_b},${fw_parts_os}
		bsp.netboot=1 panic=5;
	fi
fw_boot_net=
	run fw_net_select &&
	run fw_set_net_bootargs &&
	if test "${tftp_kernel}" = "1"; then
		run fw_load_tftp && booti ${kernel_addr_r} - ${fdt_addr_r};
	else
		run fw_load_checked_kernel && bootm ${kernel_addr_r} -;
	fi
fw_boot=
	if test "${tftp_kernel}" = "1" || test "${nfs_root}" = "1"; then
		run fw_boot_net;
	else
		run fw_boot_mmc;
	fi
bootcmd=run fw_boot
